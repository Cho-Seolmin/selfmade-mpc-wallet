# Alchemy / Infura / public Sepolia RPC
SEPOLIA_RPC_URL=

# 0xe2ECbBa8FC313bcD779A358dbE91a255A8bc071b 의 private key (0x 포함)
PRIVATE_KEY=

# 배포 후 출력된 컨트랙트 주소를 붙여넣기 (추가 mint 시 필요)
TEST_TOKEN_ADDRESS=

# 추가 mint 수량 (토큰 단위). 예: 1000 = 1000 TTK
MINT_AMOUNT=1000

# 비워두면 위 지갑으로 민팅
