# SQLite file used only by the Recovery Server (Share C).
# Keep this separate from the main API Postgres DATABASE_URL.
RECOVERY_DATABASE_URL="file:./recovery.db"

# Listen port (Main API defaults to 3000; Recovery uses 3001).
PORT=3001

# Shared secret between Main API and Recovery Server.
# Send as: Authorization: Bearer <token>
RECOVERY_SERVICE_TOKEN="change-me-recovery-service-token"

# AES-256-GCM key for Share C (64 hex chars = 32 bytes).
# MUST differ from Main API WALLET_ENCRYPTION_KEY (Share B).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_ENCRYPTION_KEY=""
