generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum WalletType {
  MULTISIG
  SSS
  KMS
  BACKEND_SEC
  MPC
  POLICY_GUARD
}

/// Lifecycle for MPC (and future) wallets.
/// Only one non-RETIRED wallet per (userId, walletType) is allowed
/// via a partial unique index in SQL.
enum WalletStatus {
  ACTIVE
  RECOVERY_PENDING
  RETIRING
  RETIRED
}

enum BalanceUnit {
  ETH
  WEI
}

enum WithdrawStatus {
  PENDING
  APPROVED
  QUEUED
  PROCESSING
  /// Signed raw tx was submitted to Sepolia; receipt wait is optional.
  BROADCASTED
  EXECUTED
  REJECTED
  FAILED
  EXPIRED
}

enum QueueStatus {
  PENDING
  RESERVED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  DEAD
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  WORKER
  SIGNER
}

enum AdminApprovalDecision {
  APPROVE
  REJECT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING)
  /// AES-256-GCM encrypted TOTP secret (base32). Key: TOTP_ENCRYPTION_KEY.
  encryptedTotpSecret String?
  /// Set when plaintext secret was returned once via /auth/totp-setup. Re-reveal blocked after.
  totpSecretRevealedAt DateTime?
  /// Incremented on password change so existing access JWTs fail validate().
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())

  wallets    Wallet[]
  approvals  AdminApproval[]
  preference UserPreference?
}

model UserPreference {
  id                  String      @id @default(cuid())
  userId              String      @unique
  defaultWalletId     String?
  balanceUnit         BalanceUnit @default(ETH)
  autoRefreshEnabled  Boolean     @default(true)
  inAppNotifications  Boolean     @default(true)
  emailNotifications  Boolean     @default(false)
  updatedAt           DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id         String       @id @default(cuid())
  userId     String
  walletType WalletType
  status     WalletStatus @default(ACTIVE)
  address    String
  /// Compressed SEC1 public key (0x-prefixed hex). Set for MPC wallets.
  mpcPublicKey String?
  /// AES-256-GCM encrypted MPC Share B (not a full private key).
  encryptedShareB String?
  /// Legacy AES-256-GCM full private key. Unused for new MPC wallets.
  encryptedPrivateKey String?
  createdAt  DateTime     @default(now())
  retiredAt  DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdraws           WithdrawRequest[]
  limit               WalletLimit?
  whitelist           Whitelist[]
  withdrawalAuditLogs WithdrawalAuditLog[]

  @@index([userId, walletType, status])
  @@index([userId, status])
}

model WithdrawRequest {
  id         String         @id @default(cuid())
  walletId   String
  amount     String // wei string
  toAddress  String
  status     WithdrawStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  approvedBy String?
  txHash     String?

  expiresAt DateTime?

  // ===== Tier1 Security 확장 필드 =====
  executionType  WalletType?
  failureReason  String?
  riskScore      Int?
  riskDecision   String?
  queuedAt       DateTime?
  processingAt   DateTime?
  broadcastedAt  DateTime?
  confirmedAt    DateTime?
  finalizedAt    DateTime?
  retryCount     Int         @default(0)
  nonce          Int?
  idempotencyKey String?     @unique
  metadata       Json?

  wallet         Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  queue          WithdrawalQueue?
  auditLogs      WithdrawalAuditLog[]
  adminApprovals AdminApproval[]

  @@index([status])
  @@index([walletId, createdAt])
  @@index([toAddress])
}

model WithdrawalQueue {
  id                String      @id @default(cuid())
  withdrawRequestId String      @unique
  status            QueueStatus @default(PENDING)
  attemptCount      Int         @default(0)
  maxAttempts       Int         @default(3)
  availableAt       DateTime    @default(now())
  reservedAt        DateTime?
  workerId          String?
  lastErrorCode     String?
  lastErrorMessage  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  withdrawRequest WithdrawRequest @relation(fields: [withdrawRequestId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
}

model WithdrawalAuditLog {
  id                String         @id @default(cuid())
  /// Optional so wallet-lifecycle events (e.g. MPC_WALLET_CREATED) can be logged.
  withdrawRequestId String?
  walletId          String
  userId            String?
  eventType         String
  actorType         AuditActorType
  actorId           String?
  message           String?
  data              Json?
  createdAt         DateTime       @default(now())

  withdrawRequest WithdrawRequest? @relation(fields: [withdrawRequestId], references: [id], onDelete: Cascade)
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([withdrawRequestId, createdAt])
  @@index([walletId, createdAt])
  @@index([eventType, createdAt])
}

model AdminApproval {
  id                String                @id @default(cuid())
  withdrawRequestId String
  adminUserId       String
  decision          AdminApprovalDecision
  comment           String?
  createdAt         DateTime              @default(now())

  withdrawRequest WithdrawRequest @relation(fields: [withdrawRequestId], references: [id], onDelete: Cascade)
  adminUser       User            @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([withdrawRequestId, createdAt])
  @@index([adminUserId, createdAt])
}

model AddressBlacklist {
  id        String   @id @default(cuid())
  address   String   @unique
  reason    String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  @@index([address, isActive])
}

model WalletLimit {
  walletId      String @id
  dailyLimit    String
  singleTxLimit String

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Whitelist {
  id       String @id @default(cuid())
  walletId String
  address  String

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, address])
}
