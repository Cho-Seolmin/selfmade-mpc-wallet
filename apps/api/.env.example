DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
# Backend public URL (used for email verification links)
APP_BASE_URL="http://localhost:3000"
# Frontend origin for REST CORS + Socket.IO (exact match required; no wildcard with credentials)
# Local:  FRONTEND_URL=http://localhost:5173
# Deploy: FRONTEND_URL=https://your-frontend-domain.example
FRONTEND_URL="http://localhost:5173"
# Optional listen port (defaults to 3000). PaaS hosts usually inject PORT.
# PORT=3000

SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"

BACKEND_SIGNER_ADDRESS="0x..."
BACKEND_SIGNER_PRIVATE_KEY="0x..."

# Shared PolicyGuard used when deploying per-user PolicyVault (POST /wallets/policy-guard).
POLICY_GUARD_ADDRESS="0x..."
# Optional legacy shared demo vault. Withdrawals use Wallet.address (per-user or pre-provisioned).
POLICY_VAULT_ADDRESS="0x..."

AWS_REGION="ap-northeast-2"
AWS_KMS_KEY_ID="your-kms-key-id"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

DFNS_BASE_URL="https://api.dfns.io"
DFNS_AUTH_TOKEN="your-dfns-auth-token"
DFNS_WALLET_ID="your-dfns-wallet-id"
DFNS_NETWORK="EthereumSepolia"
MPC_PROVIDER="DFNS"
DFNS_ORG_ID="your-dfns-org-id"
# Production (Railway): paste full PEM as a secret. Escaped \n form is supported.
# DFNS_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local fallback: path to a PEM file on disk (used only when DFNS_PRIVATE_KEY_PEM is unset).
DFNS_PRIVATE_KEY_PATH=""
DFNS_CREDENTIAL_ID="your-credential-id"

# Per-user Google Authenticator TOTP: random secret stored encrypted on User.
# Key must be 64 hex chars (32 bytes). Separate from JWT_SECRET / WALLET_ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""

# AES-256-GCM key for Main Server MPC Share B (64 hex chars = 32 bytes).
# Stored in Wallet.encryptedShareB — never a full private key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=""
# Recovery Server (Share C) — internal only, never called from the browser.
RECOVERY_BASE_URL="http://localhost:3001"
RECOVERY_SERVICE_TOKEN="change-me-recovery-service-token"
