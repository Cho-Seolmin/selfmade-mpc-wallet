# JWT_SECRET and RECOVERY_SERVICE_TOKEN: at least 32 bytes (UTF-8).
# WALLET_ENCRYPTION_KEY and TOTP_ENCRYPTION_KEY must be different 64-hex keys.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"

JWT_SECRET="change-me-jwt-secret-min-32-bytes"
JWT_EXPIRES_IN="7d"
# Backend public URL (used for email verification links)
APP_BASE_URL="http://localhost:3000"
# Frontend origin for REST CORS + Socket.IO (exact match required; no wildcard with credentials)
# Local:  FRONTEND_URL=http://localhost:5173
# Deploy: FRONTEND_URL=https://your-frontend-domain.example
FRONTEND_URL="http://localhost:5173"
# Optional listen port (defaults to 3000). PaaS hosts usually inject PORT.
# PORT=3000
# Behind Railway: NODE_ENV=production enables trust proxy 1 (req.ip = client, 1 hop).
# Local must stay off so clients cannot spoof X-Forwarded-For. Override: TRUST_PROXY=1|0

SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"
# Sepolia TestToken (TTK) — dashboard balance via ERC-20 balanceOf(MPC address)
SEPOLIA_TEST_TOKEN_ADDRESS="0xc3CF22f1a32f360B685C56Da48481007d580cDb4"
# No backend private key: MPC wallets sign & pay gas; API only uses JsonRpcProvider for balance/broadcast.

# Per-user Google Authenticator TOTP: random secret stored encrypted on User.
# Key must be 64 hex chars (32 bytes). MUST differ from WALLET_ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""

# AES-256-GCM key for Main Server MPC Share B (64 hex chars = 32 bytes).
# Stored in Wallet.encryptedShareB — never a full private key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=""
# Recovery Server (Share C) — internal only, never called from the browser.
RECOVERY_BASE_URL="http://localhost:3001"
RECOVERY_SERVICE_TOKEN="change-me-recovery-service-token"
